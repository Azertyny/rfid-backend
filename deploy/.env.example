# Production configuration, copied to /opt/vegelink/.env on the VPS (root, chmod 600).
# Placeholder values only: never commit real ones. See deploy/INSTALL.md.

# Version running (images ghcr.io/azertyny/rfid-backend and rfid-web). Written by deploy.sh: do not edit by hand.
APP_VERSION=main-0000000

# web (Caddy): domain served over HTTPS, and the email Let's Encrypt uses for expiry notices.
SITE_ADDRESS=vegelink.apolog.fr
ACME_EMAIL=ops@example.org

# db and app: PostgreSQL database, user and password (the app receives them as DB_URL / DB_USERNAME / DB_PASSWORD).
POSTGRES_DB=rfidback
POSTGRES_USER=rfid_user
POSTGRES_PASSWORD=change_me

# app: first Administrateur, created at startup only if no enabled Administrateur exists (spec 008).
# deploy.sh refuses to deploy while the password is change_me.
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change_me

# backup.sh / restore.sh: rclone remote (root's config, key without delete) and bucket where dumps go.
BACKUP_REMOTE=backup:vegelink-backups

# app: zone of the dashboard's days and hours (spec 007). Optional, default Europe/Paris.
APP_STATION_TIME_ZONE=Europe/Paris
