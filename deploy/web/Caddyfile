{
	email {$ACME_EMAIL}
}

# Plain HTTP: never forward an API call. Caddy's redirect is a 308, which keeps the method and body, so a reader
# following it would replay an HTTP scan over HTTPS (spec 009, FR-009a). The ACME challenge is answered before this.
http://{$SITE_ADDRESS} {
	handle /api/* {
		respond "HTTPS required" 403
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# No access log on purpose: reader devices and line kiosks send their token in the x-api-token request header
# (spec 008, SC-006). If a `log` directive is ever added, drop that header, e.g.
#   log { format filter { wrap json; fields { request>headers>X-Api-Token delete } } }
{$SITE_ADDRESS} {
	encode gzip

	handle /api/* {
		reverse_proxy app:8080
	}
	handle /actuator/health {
		reverse_proxy app:8080
	}
	handle /actuator/* {
		respond 404
	}
	handle {
		root * /srv/front
		file_server
	}
}
